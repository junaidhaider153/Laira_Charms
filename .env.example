# Laira Charms Environment Variables Configuration
# Copy this file to .env.local for local development.

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Supabase Client (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://dummy-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key-for-development

# Server-Only Supabase Privileges (NEVER expose to NEXT_PUBLIC_* or browser)
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-for-server-only
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Transactional Email Adapter (Resend or mock adapter)
RESEND_API_KEY=re_dummy_mock_key_for_testing
EMAIL_FROM=Laira Charms <no-reply@lairacharms.pk>

# Security Secrets & Tokens
GUEST_TOKEN_SECRET=laira-charms-secure-guest-hmac-secret-min-32-chars
ADMIN_BOOTSTRAP_TOKEN=laira-admin-bootstrap-dev-token-only
